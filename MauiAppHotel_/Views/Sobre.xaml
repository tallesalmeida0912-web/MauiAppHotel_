<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel_.Views.Sobre"
    Title="Sobre"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray200}">

    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Sobre o Aplicativo"
            FontSize="35"
            FontAttributes="Bold"
            TextColor="{StaticResource MidnightBlue}"
            HorizontalOptions="Center" />

        <Border
            Padding="20"
            Stroke="{StaticResource OffBlack}"
            StrokeShape="RoundRectangle 15">

            <VerticalStackLayout Spacing="15">

                <Label
                    Text="Hotel App"
                    FontSize="25"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="{StaticResource MidnightBlue}" />

                <Label
                    Text="Aplicativo desenvolvido para facilitar a contratação e organização de hospedagens."
                    FontSize="16"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Desenvolvedor: Talles Honorio de Almeida"
                    FontSize="16" />

                <Label
                    Text="Ano de desenvolvimento: 2026"
                    FontSize="16" />

                <Label
                    Text="Versão 1.0"
                    FontSize="14"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Border>

        <Button
            Text="Voltar"
            Clicked="OnVoltarClicked"
            BackgroundColor="MidnightBlue"/>

    </VerticalStackLayout>

</ContentPage>
